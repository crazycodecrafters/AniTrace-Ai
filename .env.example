# ====================================================================
# AniTrace AI - Environment Configuration Template
# All settings below are optional. AniTrace AI runs out-of-the-box
# with client-side load balancers and public endpoints.
# ====================================================================

# Optional Trace.moe API key for higher rate limits (5000+ requests/month)
# Obtain from https://trace.moe/
VITE_TRACE_MOE_API_KEY=

# Optional custom GraphQL endpoint for AniList
VITE_ANILIST_API_URL=https://graphql.anilist.co

# Optional CORS Proxy override for strict corporate intranet environments
VITE_CORS_PROXY_URL=https://corsproxy.io/?url=
